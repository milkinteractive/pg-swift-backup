# PostgreSQL Database Configuration
# All variables support _FILE suffix for Docker Secrets (e.g., DB_PASSWORD_FILE=/run/secrets/db_password)
DB_HOST=your-database-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=your-username
DB_PASSWORD=your_database_password_here
# Or use: DB_PASSWORD_FILE=/run/secrets/db_password

# OpenStack Swift Configuration (Infomaniak)
SWIFT_AUTH_URL=https://swiss-backup04.infomaniak.com/identity/v3
SWIFT_USERNAME=SBI-XXXXXXX
SWIFT_PASSWORD=your_generated_password_here
# Or use: SWIFT_PASSWORD_FILE=/run/secrets/swift_password
SWIFT_CONTAINER=your-container-name

# Required Swift Configuration
SWIFT_TENANT_NAME=sb_project_SBI-XXXXXXX
SWIFT_REGION=RegionOne

# Backup Configuration
DB_DUMP_INCLUDED_SCHEMAS=public
DB_TMP_BACKUP_DIR=/backups
# SWIFT_PREFIX: Path prefix within the Swift container (optional)
# Leave empty for root of container, or set to a folder name like "backups"
# Example: SWIFT_PREFIX=backups -> Files stored at: container/backups/filename
#          SWIFT_PREFIX=        -> Files stored at: container/filename
SWIFT_PREFIX=backups
# Set to 0 to disable cleanup (keep all backups indefinitely)
SWIFT_RETENTION_DAYS=30

# Timezone (optional)
TZ=Europe/Zurich

# Cron Schedule (optional)
# Format: Minute Hour Day Month Weekday
# Default: 0 2 * * * (daily at 2 AM)
# Note: Do NOT use quotes around the cron schedule
# CRON_SCHEDULE=0 2 * * *

# Run backup on container startup (optional)
# Default: false
# Note: Do NOT use quotes (use true or false, not "true" or "false")
# RUN_ON_STARTUP=false

# Backup Options (optional)
# DB_DUMP_ROLES=true              # Export database roles (default: true)
# DB_DUMP_KEEP_COMMENTS=false     # Keep SQL comments (default: false)
# DB_DUMP_USE_COPY=false          # Use COPY instead of INSERT syntax (default: false)

# Table Filtering (optional, mutually exclusive - only set one)
# DB_DUMP_INCLUDE_TABLES=public.users,public.orders     # Only backup these tables
# DB_DUMP_EXCLUDE_TABLES=public.logs,public.sessions    # Backup all except these tables

# Supabase Configuration Overrides (optional, auto-detected if not set)
# Only set these if you need to override the Supabase CLI defaults
# DB_DUMP_INTERNAL_SCHEMAS=auth|extensions|pgbouncer|...
# DB_DUMP_RESERVED_ROLES=anon|authenticated|...
# DB_DUMP_ALLOWED_CONFIGS=pgaudit.*|pgrst.*|...
