# PostgreSQL Database Configuration
DB_HOST=your-database-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=your-username
DB_PASSWORD=your_database_password_here

# OpenStack Swift Configuration (Infomaniak)
SWIFT_AUTH_URL=https://swiss-backup04.infomaniak.com/identity/v3
SWIFT_USERNAME=SBI-XXXXXXX
SWIFT_PASSWORD=your_generated_password_here
SWIFT_CONTAINER=your-container-name

# Required Swift Configuration
SWIFT_TENANT_NAME=sb_project_SBI-XXXXXXX
SWIFT_REGION=RegionOne

# Backup Configuration
INCLUDED_SCHEMAS=public
BACKUP_DIR=/backups
# SWIFT_PREFIX: Path prefix within the Swift container (optional)
# Leave empty for root of container, or set to a folder name like "backups"
# Example: SWIFT_PREFIX=backups -> Files stored at: container/backups/filename
#          SWIFT_PREFIX=        -> Files stored at: container/filename
SWIFT_PREFIX=backups
RETENTION_DAYS=30

# Timezone (optional)
TZ=Europe/Zurich

# Cron Schedule (optional, overrides docker-compose.yml)
# Format: Minute Hour Day Month Weekday
# Default: 0 2 * * * (daily at 2 AM)
# Note: Do NOT use quotes around the cron schedule
# CRON_SCHEDULE=0 2 * * *

# Run backup on container startup (optional)
# Default: false
# Note: Do NOT use quotes (use true or false, not "true" or "false")
# RUN_ON_STARTUP=false

# Advanced PostgreSQL Dump Options (optional)
# EXTRA_FLAGS=--column-inserts --rows-per-insert 8000
# SED_REMOVE_COMMENTS=/^--/d
