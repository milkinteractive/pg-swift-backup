#!/usr/bin/env bash
# Rejects a commit that would add a secret in plain text. It checks what is
# staged, not the working tree:
# - no .env file anywhere, except templates (*.example, *.sample);
# - no key files (*.pem, *.key, *.p12, private SSH keys, keystores);
# - betterleaks finds no token or key inside any staged change (reviewed
#   false positives: .betterleaksignore).
# Enable once per clone (betterleaks comes with the Brewfile):
#   git config core.hooksPath .githooks
set -euo pipefail

command -v betterleaks >/dev/null ||
  { echo "pre-commit: betterleaks is missing (brew bundle)" >&2; exit 1; }

fail=0
reject() { echo "pre-commit: $1: $2" >&2; fail=1; }

# NUL-separated and unquoted, so any file name arrives verbatim; matched in
# lower case because macOS ignores case (.ENV is .env).
while IFS= read -r -d '' f; do
  lc=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')
  case "$lc" in
    *.example|*.sample) ;;
    .env|.env.*|.env-*|*/.env|*/.env.*|*/.env-*|*.env)
      reject "$f" "plaintext env file; pass secrets via _FILE or a secret store" ;;
    *.pub) ;;
    *.pem|*.key|*.p12|*.pfx|*.p8|*.jks|*.keystore|*.pepk|*.ppk)
      reject "$f" "key file" ;;
    id_rsa*|*/id_rsa*|id_ecdsa*|*/id_ecdsa*|id_ed25519*|*/id_ed25519*)
      reject "$f" "private SSH key" ;;
  esac
done < <(git -c core.quotePath=false diff --cached --name-only -z --diff-filter=ACMRT)

# Tokens and keys inside any staged change; values are redacted, nothing is
# sent anywhere (live validation stays off). betterleaks 1 and 2 take
# different commands for staged changes. Version 2 gets only the entries of
# .betterleaksignore it can read (hashes of values); entries in the older
# form would print a warning each on every commit.
scan=0
case "$(betterleaks version 2>/dev/null | sed -n -E 's/^[^0-9]*([0-9]+)\..*/\1/p' | head -1)" in
  1)
    betterleaks git --pre-commit --staged --redact --no-banner --verbose --log-level warn || scan=$? ;;
  2)
    ignore="$(git rev-parse --git-dir)/betterleaksignore"
    grep -E '^([0-9a-fA-F]{64}|hmac-sha256:[0-9a-fA-F]+)$' .betterleaksignore > "$ignore" 2>/dev/null || true
    git diff --cached --no-ext-diff --no-textconv --no-color --src-prefix=a/ --dst-prefix=b/ |
      betterleaks stdin --git-diff --redact --no-banner --log-level warn --ignore-file "$ignore" || scan=$? ;;
  *)
    scan=2 ;;
esac
case "$scan" in
  0) ;;
  1) echo "pre-commit: betterleaks found a secret (see above)" >&2; fail=1 ;;
  *) echo "pre-commit: betterleaks could not scan (exit $scan); this hook knows betterleaks 1 and 2" >&2; fail=1 ;;
esac

exit "$fail"
